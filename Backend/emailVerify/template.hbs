<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>SKCodingSchool security code</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f5f9;color:#172033;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      Your SKCodingSchool one-time code is {{otp}}. It expires in 10 minutes.
    </div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f3f5f9;padding:36px 14px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border:1px solid #e5e9f0;border-radius:18px;overflow:hidden;">
            <tr>
              <td style="padding:25px 34px;background:#111c35;">
                <p style="margin:0;color:#ffffff;font-size:18px;line-height:1.4;font-weight:700;letter-spacing:.2px;">SKCodingSchool</p>
                <p style="margin:7px 0 0;color:#a9bce9;font-size:11px;line-height:1.5;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;">Account security</p>
              </td>
            </tr>
            <tr>
              <td style="padding:34px 34px 12px;">
                <p style="margin:0 0 10px;color:#526078;font-size:14px;line-height:1.6;">Hello {{username}},</p>
                <h1 style="margin:0;color:#172033;font-size:25px;line-height:1.3;font-weight:700;">Your one-time passcode</h1>
                <p style="margin:14px 0 0;color:#526078;font-size:15px;line-height:1.7;">Use this code to {{purpose}}. For your security, it will expire in <strong style="color:#25324a;">10 minutes</strong>.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 34px 24px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #dfe7fb;border-radius:12px;background:#f5f7ff;">
                  <tr>
                    <td align="center" style="padding:20px 12px 8px;color:#61708a;font-size:11px;line-height:1.4;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">Your verification code</td>
                  </tr>
                  <tr>
                    <td align="center" style="padding:4px 12px 20px;color:#214fbd;font-size:36px;line-height:1.25;font-weight:700;letter-spacing:10px;font-family:Arial,Helvetica,sans-serif;">{{otp}}</td>
                  </tr>
                </table>
                <p style="margin:18px 0 0;color:#526078;font-size:13px;line-height:1.7;">Enter this code only on the SKCodingSchool website. We will never ask you to share it by email, phone, or message.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 34px 26px;border-top:1px solid #edf0f5;">
                <p style="margin:0;color:#657187;font-size:13px;line-height:1.7;">If you didn't request this code, you can ignore this message. Your account remains secure.</p>
                <p style="margin:16px 0 0;color:#8993a5;font-size:11px;line-height:1.6;">Automated security email from SKCodingSchool. Please do not reply to this message.</p>
              </td>
            </tr>
          </table>
          <p style="margin:16px 0 0;color:#929bad;font-size:11px;line-height:1.5;">© SKCodingSchool</p>
        </td>
      </tr>
    </table>
  </body>
</html>
