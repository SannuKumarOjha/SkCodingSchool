<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Your SKCodingSchool security code</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#172033;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f3f6fb;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border:1px solid #e5eaf2;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="padding:28px 32px;background:#101c38;color:#ffffff;">
                <p style="margin:0;font-size:13px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;color:#b8c8ff;">SKCodingSchool</p>
                <h1 style="margin:12px 0 0;font-size:24px;line-height:1.3;">Your one-time code</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:30px 32px 16px;font-size:15px;line-height:1.7;">
                <p style="margin:0 0 14px;">Hello {{username}},</p>
                <p style="margin:0 0 20px;color:#526078;">Hello {{username}}, use this one-time code to {{purpose}}. It expires in 10 minutes.</p>
                <div style="margin:24px 0;padding:18px 12px;border:1px solid #dce5ff;border-radius:12px;background:#f5f7ff;text-align:center;">
                  <span style="font-size:34px;line-height:1.3;font-weight:bold;letter-spacing:10px;color:#2457d6;">{{otp}}</span>
                </div>
                <p style="margin:0;color:#526078;">If you didn't request this code, you can safely ignore this email. Never share your verification code with anyone.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 32px 26px;border-top:1px solid #edf0f5;font-size:12px;line-height:1.6;color:#7a8497;">
                This is an automated message from SKCodingSchool. Please do not reply to this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>